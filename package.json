{
  "name": "paperwind",
  "productName": "Paperwind",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "test": "vite build && electron scripts/selftest.cjs samples/示例.md test-output",
    "perf": "vite build && node scripts/perf-run.cjs --modes=p01,p02,p04",
    "perf:keys": "node scripts/perf-run.cjs --modes=p03",
    "perf:all": "vite build && node scripts/perf-run.cjs --modes=p01,p02,p03,p04,p05 --minutes=30",
    "screenshot": "vite build && electron scripts/screenshot.cjs samples/示例.md test-output/real",
    "samples": "node scripts/make-samples.cjs",
    "icon": "electron scripts/make-icon.cjs"
  },
  "devDependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-bubble-menu": "^2.27.3",
    "@tiptap/extension-code-block": "^2.27.3",
    "@tiptap/extension-code-block-lowlight": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-strike": "^2.27.3",
    "@tiptap/extension-subscript": "^2.27.3",
    "@tiptap/extension-superscript": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "lowlight": "^3.3.0",
    "markdown-it-mark": "^4.0.0",
    "mermaid": "^12.3.0",
    "tiptap-markdown": "^0.8.10",
    "vite": "^6.4.5"
  },
  "main": "electron/main.cjs",
  "description": "Paperwind：像备忘录一样好用的所见即所得 Markdown 编辑器",
  "author": "Sizhuo Li",
  "build": {
    "appId": "local.markdown.notes",
    "productName": "Paperwind",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Paperwind",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "MarkdownNotes.Document",
        "description": "Markdown 文档",
        "role": "Editor",
        "icon": "icon.ico"
      }
    ]
  }
}
